<Window x:Class="KioskMeet.MeetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Google Meet"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black">
    <Grid>
        <wv2:WebView2 x:Name="MeetWebView" />

        <Button x:Name="CloseButton"
                Content="✕ Ukončit a vrátit se"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,14,0"
                Padding="14,8"
                Background="#1b2432"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                Cursor="Hand"
                Opacity="0.88"
                Click="CloseButton_Click" />

        <Border x:Name="AutofillInfoPanel"
                Visibility="Collapsed"
                Background="#E61b2432"
                CornerRadius="10"
                Padding="16,12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="14"
                BorderBrush="#f5a623"
                BorderThickness="1">
            <StackPanel MaxWidth="360">
                <TextBlock Text="Appka zkusila vyplnit formulář automaticky."
                           Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Foreground="#d3dae3" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Pokud pole zůstala prázdná, hodnoty jsou zkopírované ve schránce - stačí kliknout do pole a stisknout Ctrl+V:"/>
                <TextBlock x:Name="AutofillIdText" Foreground="#f5a623" FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                <TextBlock x:Name="AutofillPasscodeText" Foreground="#f5a623" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
